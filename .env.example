# Copy this file to ".env" for local testing, and set the SAME values in
# Vercel -> Project -> Settings -> Environment Variables for production.

# --- Google Sheets (required) ---------------------------------------------
# The Google Sheet to append leads to (currently your existing sheet).
SHEET_ID=YOUR_SHEET_ID

# Paste the ENTIRE contents of your service-account JSON (GoogleSheets/final.json)
# as ONE value. Keep the surrounding braces. Example shape (do NOT commit the real key):
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
GOOGLE_SERVICE_ACCOUNT=

# --- Country access control (optional) ------------------------------------
# Pick ONE approach. Leave both blank to allow all countries.
#
# Allowlist mode: allow ONLY these ISO country codes (recommended for a US product):
# ALLOWED_COUNTRIES=US
#
# Blocklist mode: block these ISO country codes:
# BLOCKED_COUNTRIES=
ALLOWED_COUNTRIES=
BLOCKED_COUNTRIES=
